[Unit]
Description=TradeTrackr PostgreSQL Backup
Documentation=https://github.com/your-org/tradetrackr/blob/main/docs/WORKSTREAM_E_BACKUPS.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=myvps
Group=myvps
EnvironmentFile=/opt/tradetrackr-ops/.env
WorkingDirectory=/opt/tradetrackr-api
ExecStart=/opt/tradetrackr-api/scripts/backup/postgres-backup.sh

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/tmp

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tradetrackr-backup-postgres

# Timeout (30 minutes max)
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target

